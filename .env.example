# Copy to .env.local for local development, and to .env directly on the
# server for production — never commit either file.

# Resend (transactional email) — powers the contact form at
# src/app/api/contact/route.ts. Sign up free at https://resend.com, create
# an API key, and either verify a sending domain or use Resend's shared
# onboarding domain to start.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
